{
  "$schema": "gmsh DOE smoke fixture v1",
  "description": "Minimal DOE smoke-test input for the gmsh wheel. Single-factor, four-run screening design. No PII, no proprietary data. Size: <2KB.",
  "campaign": {
    "name": "smoke-test-campaign",
    "factor_group": "query_core",
    "n_runs": 4,
    "seed": 42
  },
  "factors": [
    {
      "name": "temperature",
      "type": "continuous",
      "low": 0.0,
      "high": 1.0
    }
  ],
  "scenarios": [
    {
      "id": "smoke-scn-001",
      "prompt": "List the three divisions of Acme Widgets.",
      "expected_entities": ["Consumer Widgets", "Industrial Widgets", "Research Widgets"]
    },
    {
      "id": "smoke-scn-002",
      "prompt": "Which division is pre-revenue?",
      "expected_entities": ["Research Widgets"]
    }
  ],
  "gates": {
    "pass_rate_min": 0.75,
    "hallucination_rate_max": 0.10
  }
}
