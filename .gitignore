build_nuitka_linux/

# spike — build + dist artifacts regenerated on demand.
scripts/spikes/namespace_nuitka/build-a-compiled/
scripts/spikes/namespace_nuitka/dist/
.ipynb_checkpoints/

# Runtime output directories — regenerated by lab runs; not worth
# tracking the binary .pt weights + per-run JSON artifacts.  Mirror
# script already prunes these via PRIVATE_TREES; gitignoring them
# keeps teammates' local env clean after re-running any notebook.
agent_stores/
cap_experiments/
docgms_store/
doe_test_tracing/
doe_tracing_store/
finstructbench_results/
ga_learning_store/
gms_stores/
gms_wikis/
governance_monograph/lab_stores/
# tutorials/lab_stores/ch04_ground_truth/model.pt is intentionally tracked
# (pre-built fixture that ships in the harness wheel and gmsh mirror).
# Only ignore model.pt in dev-generated stores outside the pre-built fixture.
knowlytix/harness/testing/tutorials/lab_stores/ch18_*/model.pt
harness_session_store/
presentation/demo/lab_stores/

# (2026-05-01): test result fixtures regenerated by run_llm_benchmark.py.
# Historical fixtures moved to /dev_test_results/ at repo root; future local runs
# regenerate into this in-tree dir but should not be committed (would re-leak into
# the harness wheel — hatchling force-include overrides the toml exclude).
knowlytix/harness/testing/tests/results/

# Notebook execution outputs (per-run artifacts; never committed).
# 2026-05-07: governance USER_GUIDE companion notebooks moved from
# tutorials/user_guide/notebooks/ to knowlytix/harness/governance/tutorials/notebooks/.
# The notebooks generate `_figures/` (HTML/PNG dashboards) and `_bundles/`
# (signed governance bundles via ch25's `build_bundle().save(...)`); both
# regenerate into the in-tree dir on each run and must not ship in the wheel.
knowlytix/harness/governance/tutorials/notebooks/_figures/
knowlytix/harness/governance/tutorials/notebooks/_bundles/

# Executed notebooks are generated artifacts — never check in.
*_executed.ipynb
