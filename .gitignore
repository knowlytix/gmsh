!.env.example
*.lic
*.pem
*.key
!packaging/knowlytix-core/knowlytix-public.pem
# Trusted rotation / self-serve PUBLIC keys are safe to commit.
# Private keys never live here — they stay in the secret store.
!packaging/knowlytix-core/_license_keys/*.pem

