# GMS / GMSH / DocGMS / FinStructBench environment variables.
#
# Copy to `.env` and edit. `.env` is gitignored; `.env.example` is
# tracked and should stay provider-agnostic — use YOUR_KEY_HERE
# placeholders, never real keys.
#
# Precedence: explicit kwargs > env vars > YAML config > code defaults.
# Blank/whitespace env values are treated as unset.

# ---------------------------------------------------------------------------
# Provider API keys (set the one(s) matching your GMS_LLM_MODEL)
# ---------------------------------------------------------------------------
# LiteLLM dispatches to the right provider based on the model string prefix
# (e.g. `anthropic/…`, `openai/…`, `google/…`, `ollama/…`). A missing key
# surfaces as `gms.llm.LLMConfigError` at first call with an actionable
# message listing the exact env var(s) to set.

# ANTHROPIC_API_KEY=YOUR_KEY_HERE
# OPENAI_API_KEY=YOUR_KEY_HERE
# GOOGLE_API_KEY=YOUR_KEY_HERE
# MISTRAL_API_KEY=YOUR_KEY_HERE
# TOGETHER_API_KEY=YOUR_KEY_HERE
# COHERE_API_KEY=YOUR_KEY_HERE
# Bedrock needs the full trio:
# AWS_ACCESS_KEY_ID=YOUR_KEY_HERE
# AWS_SECRET_ACCESS_KEY=YOUR_KEY_HERE
# AWS_REGION_NAME=us-east-1
# Azure needs three values as well:
# AZURE_API_KEY=YOUR_KEY_HERE
# AZURE_API_BASE=https://YOUR-RESOURCE.openai.azure.com
# AZURE_API_VERSION=2024-02-01
# Ollama is key-free; override the default http://localhost:11434 if needed:
# OLLAMA_BASE_URL=http://localhost:11434

# ---------------------------------------------------------------------------
# gms.llm.LLMSettings  (prefix: GMS_LLM_)
# ---------------------------------------------------------------------------
# Default model and dispatch tuning for every LLM call routed through
# `gms.llm.LLMClient`. Purpose-specific overrides fall back to `GMS_LLM_MODEL`
# when unset.

# GMS_LLM_MODEL=anthropic/claude-opus-4-6
# GMS_LLM_MODEL_JUDGE=           # harness LLM-as-judge (semantic verifier)
# GMS_LLM_MODEL_GENERATOR=       # DOE question generators
# GMS_LLM_MODEL_SCORER=          # finstructbench scorer
# GMS_LLM_MODEL_DS_AGENT=        # data-science agent
# GMS_LLM_MODEL_WIKI=            # gms-wiki flows
# GMS_LLM_TIMEOUT_SECONDS=60
# GMS_LLM_MAX_RETRIES=3
# GMS_LLM_TEMPERATURE=0.0

# ---------------------------------------------------------------------------
# gms.GMSCoreSettings  (prefix: GMS_)
# ---------------------------------------------------------------------------
# Flat env-var view of the user-facing `gms-core` tunables.

# GMS_D_V=384                    # semantic embedding dim
# GMS_D_U=384                    # logical embedding dim
# GMS_M=128                      # projected shared dim
# GMS_D=128                      # working dim for rotors
# GMS_TAU_ENT=0.8                # entailment threshold
# GMS_TAU_CONTRA=1.7             # contradiction threshold
# GMS_TAU_PATH=0.5               # path consistency threshold
# GMS_ALPHA_DECAY=0.1            # holonomy decay rate
# GMS_MU_HOLONOMY=0.1
# GMS_TRAIN_EPOCHS=200
# GMS_TRAIN_BATCH_SIZE=512
# GMS_TRAIN_LR=1e-3
# GMS_TRAIN_NUM_NEG=64
# GMS_STORES_DIR=./gms_stores

# ---------------------------------------------------------------------------
# docgms.DocGMSSettings  (prefix: DOCGMS_)
# ---------------------------------------------------------------------------

# DOCGMS_MAX_PAGES=200
# DOCGMS_CHUNK_SIZE=4000         # chars per LLM chunk for table extraction
# DOCGMS_N_STEPS=50              # Riemannian GD steps for new entities
# DOCGMS_FREEZE_EXISTING=true
# DOCGMS_CONTRADICTION_GATE=true
# DOCGMS_AUTO_LEARN=true
# DOCGMS_STORE_PATH=docgms_store

# ---------------------------------------------------------------------------
# finstructbench.FinStructBenchSettings  (prefix: FINSTRUCTBENCH_)
# ---------------------------------------------------------------------------

# FINSTRUCTBENCH_FLOAT_TOL=1e-6
# FINSTRUCTBENCH_CLOSE_THRESHOLD=0.01
# FINSTRUCTBENCH_TUPLE_ELEMENT_TOL=1e-3

# ---------------------------------------------------------------------------
# harness.settings.GMSHSettings  (prefix: GMSH_)
# ---------------------------------------------------------------------------
# DOE benchmark, parallelism, resource limits, paths, and feature flags.

# DOE knobs
# GMSH_DOE_N_RUNS=32
# GMSH_DOE_SEED=42
# GMSH_DOE_MAX_PER_CATEGORY=10
# GMSH_DOE_INGEST_EPOCHS=200
# GMSH_DOE_SLA_LATENCY_MS=5000
# GMSH_DOE_COST_BUDGET_USD=10
# GMSH_DOE_HALLUCINATION_THRESHOLD=1.0
# GMSH_DOE_STATEFUL_SESSION_COUNT=5
# GMSH_LIVE_DASHBOARD_PORT=8765

# Parallelism
# GMSH_MAX_WORKERS=4
# GMSH_QUESTION_TIMEOUT_S=120
# GMSH_MAX_RETRIES=2
# GMSH_RETRY_DELAY_S=1.0

# Harness-core resource limits
# GMSH_MAX_TURNS=30
# GMSH_TRUNCATE_RESULT_AT=8000
# GMSH_MAX_MESSAGE_TOKENS=180000
# GMSH_MEMORY_CONTEXT_LINES=30

# Storage paths
# GMSH_STORES_DIR=./gms_stores
# GMSH_TRACING_DIR=./doe_tracing_store
# GMSH_RUNS_DIR=./runs
# GMSH_CAMPAIGNS_DIR=./campaigns
# GMSH_SESSION_STORE_PATH=./harness_session_store

# Feature flags (all default false except GMSH_ENABLE_TRACING)
# GMSH_ENABLE_TRACING=true
# GMSH_ENABLE_TYPED_VERDICTS=false
# GMSH_ENABLE_PROVENANCE=false
# GMSH_ENABLE_GATEWAY=false
# GMSH_ENABLE_POLICY_ENGINE=false
# GMSH_ENABLE_SCENARIO_REGISTRY=false
# GMSH_ENABLE_PROCESS_EVALUATION=false
# GMSH_ENABLE_RECOVERY_EVALUATION=false
# GMSH_ENABLE_INTERACTION_EVALUATION=false
# GMSH_ENABLE_SEVERITY_CLASSIFICATION=false
# GMSH_ENABLE_PERFORMANCE_PROFILING=false
# GMSH_ENABLE_COST_TRACKING=false
# GMSH_ENABLE_STATEFUL_TESTING=false
# GMSH_ENABLE_HALLUCINATION_TESTING=false
# GMSH_ENABLE_CALIBRATION_TESTING=false
# GMSH_ENABLE_MULTI_AGENT=false
# GMSH_ENABLE_CROSS_DOCUMENT=false
# GMSH_ENABLE_DISAMBIGUATION_TESTING=false
# GMSH_ENABLE_INVARIANCE_TESTING=false
# GMSH_ENABLE_STREAMING_TESTING=false
# GMSH_ENABLE_LIVE_DASHBOARD=false
