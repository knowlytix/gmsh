# knowlytix-benchmark wheel manifest (; renamed; moved).
#
# Hatchling drives the wheel layout via pyproject.toml. This MANIFEST is
# kept for sdist parity. Smoke fixtures and the five bundled
# benchmark instance markdowns ship alongside the Python source so the
# README quickstart runs against `importlib.resources.files(...)`.

include README.md
include pyproject.toml
include ../../LICENSE

# Smoke fixtures + fixture package __init__.py files.
recursive-include ../../knowlytix/benchmark/fixtures *.json *.md *.py

# Bundled benchmark instances — stable data contract documented in
# packaging/knowlytix-benchmark/README.md.
recursive-include ../../knowlytix/benchmark/instances *.md *.py

# Exclude build/test artifacts and per-run outputs.
global-exclude *.pyc
global-exclude __pycache__
global-exclude .pytest_cache
prune build
prune dist
prune *.egg-info
prune ../../knowlytix/benchmark/results

# Exclude generator scripts (kept in repo for regenerating fixtures;
# not part of the shipped API).
exclude ../../knowlytix/benchmark/instances/generate_*.py
exclude ../../knowlytix/benchmark/instances/gen_*.py

# Legacy standalone pyproject — the scoped one is authoritative.
exclude ../../knowlytix/benchmark/pyproject.toml
