# knowlytix-knowledge wheel manifest ( moved docgms/ → knowlytix/knowledge/).
#
# Hatchling drives the wheel layout via pyproject.toml. This MANIFEST is
# kept for sdist parity. The per-package slice of smoke fixtures
# plus __init__.py stubs land via `recursive-include` so
# `importlib.resources.files("knowlytix.doc.fixtures.smoke")` resolves at runtime.

include README.md
include pyproject.toml
include ../../LICENSE

# Smoke fixtures + fixture package __init__.py files.
recursive-include ../../knowlytix/knowledge/fixtures *.md *.py

# Exclude build/test artifacts.
global-exclude *.pyc
global-exclude __pycache__
global-exclude .pytest_cache
prune build
prune dist
prune *.egg-info

# Modules intentionally kept out of the wheel (see pyproject comments).
exclude ../../knowlytix/knowledge/mcp_server.py
exclude ../../knowlytix/knowledge/web_agent.py
exclude ../../knowlytix/knowledge/cli.py
exclude ../../knowlytix/knowledge/__main__.py
